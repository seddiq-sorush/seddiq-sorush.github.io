---
import Layout from "~/layouts/PageLayout.astro";

import Header from "~/components/widgets/Header.astro";
import Hero from "~/components/widgets/Hero.astro";
import Content from "~/components/widgets/Content.astro";
import Experience from "~/components/widgets/Experience.astro";
import Steps from "~/components/widgets/Steps.astro";
import Features3 from "~/components/widgets/Features3.astro";
import BlogLatestPosts from "~/components/widgets/BlogLatestPosts.astro";
import { getPermalink } from "~/utils/permalinks";

import MyPhoto from "~/assets/images/my-photo.png";

import { experiences } from "~/content/data/experiences";
import { headerData } from "~/navigation";
const metadata = {
  title: "Home",
};
---

<Layout metadata={metadata}>
  <Fragment slot="announcement"></Fragment>
  <Fragment slot="header">
    <Header {...headerData} isSticky showToggleTheme />
  </Fragment>

  <!-- Hero Widget ******************* -->

  <Hero
    id="hero"
    title="Seddiq Sorush"
    tagline="Senior Software Engineer — Full-Stack &amp; Distributed Systems"
    actions={[
      {
        variant: "primary",
        text: "Contact",
        href: getPermalink("/contact#form"),
      },
      {
        variant: "secondary",
        text: "Résumé",
        href: "/resume.pdf",
        target: "_blank",
      },
      {
        variant: "secondary",
        text: "GitHub",
        href: "https://github.com/podcoder",
        target: "_blank",
      },
      {
        variant: "secondary",
        text: "LinkedIn",
        href: "https://www.linkedin.com/in/seddiqsorush",
        target: "_blank",
      },
    ]}
  >
    <Fragment slot="subtitle">
      I build and modernize the systems people depend on — retirement and benefits
      platforms, clinical records, national identity systems, and high-traffic
      e-commerce. San Francisco Bay Area · 12+ years of experience.
    </Fragment>
  </Hero>

  <!-- Content Widget: About **************** -->

  <Content
    id="about"
    columns={3}
    items={[
      {
        icon: "tabler:brand-linkedin",
        callToAction: {
          target: "_blank",
          text: "LinkedIn",
          href: "https://www.linkedin.com/in/seddiqsorush",
        },
      },
      {
        icon: "tabler:brand-github",
        callToAction: {
          target: "_blank",
          text: "Github",
          href: "https://github.com/podcoder",
        },
      },
      {
        icon: "tabler:mail",
        callToAction: {
          text: "Email",
          href: "mailto:seddiq.sorush@gmail.com",
        },
      },
    ]}
    image={{
      src: MyPhoto,
      alt: "Seddiq Sorush",
      loading: "eager",
    }}
  >
    <Fragment slot="content">
      <h2 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">
        About me
      </h2>
      <p>
        I'm a senior software engineer with 12+ years building and modernizing
        systems that people rely on but rarely think about. My work spans
        public-sector, healthcare, and commercial software — a county retirement
        system, a US healthcare EHR, national identity and passport systems, and
        high-traffic e-commerce.
      </p>
      <br />
      <p>
        I work across the stack — Java, C#/.NET, React, and Node — with a focus
        on distributed architecture (microservices, Apache Kafka, PostgreSQL) and
        the interfaces that surface it. I like the unglamorous parts that make
        software trustworthy: data migration, reconciliation, authentication, and
        reliability. I've led teams of 4 to 10, and I still write production
        code.
      </p>
      <br />
      <p>
        Right now I'm deepening my work in AI — completing an AI Engineering
        credential and studying generative AI — because I think the engineers
        who stay valuable are the ones who learn to build with these tools. I
        also teach data structures and algorithms as an adjunct instructor.
      </p>
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Experience Widget ****************** -->

  <Experience id="resume" title="Work experience" items={experiences} />

  <!-- Steps Widget: Education ****************** -->

  <Steps
    id="education"
    title="Education"
    items={[
      {
        title: `Bachelor of Technology, Electronics Engineering <br /> <span class="font-normal">Savitribai Phule Pune University</span> <br /> <span class="text-sm font-normal">2012 – 2016 · First Class</span>`,
        icon: "tabler:school",
      },
    ]}
    classes={{ container: "max-w-3xl" }}
  />

  <div class="max-w-3xl mx-auto px-4 md:px-6 -mt-8 md:-mt-12 pb-12 md:pb-16">
    <p class="text-sm text-muted rounded-lg border border-gray-200 dark:border-slate-800 px-4 py-3">
      <span class="font-semibold text-default">Currently in progress:</span>
      AI Engineering with Claude — Udacity, and Generative AI — Udacity.
    </p>
  </div>

  <!-- Features3 Widget: Skills ************** -->

  <Features3
    id="skills"
    title="Skills"
    subtitle="Technologies I use across the stack, grouped by where they fit."
    columns={2}
    defaultIcon="tabler:point-filled"
    items={[
      {
        title: "Languages",
        description: "Java, C# / .NET, Python, TypeScript / JavaScript, Kotlin, SQL",
      },
      {
        title: "Front-End",
        description: "React, Angular, Vue, LitElement, micro-frontends, HTML/CSS, Tailwind",
      },
      {
        title: "Backend & Data",
        description:
          "Spring Boot, Node/Express, microservices, REST/GraphQL, Apache Kafka; PostgreSQL, MS SQL Server, MongoDB, Redis, Oracle",
      },
      {
        title: "Cloud & DevOps",
        description: "AWS, Azure, GCP, Docker, Kubernetes, Jenkins, CI/CD, Azure DevOps, monitoring & observability, Git",
      },
      {
        title: "Security",
        description: "OAuth 2.0, OpenID Connect, Keycloak, role-based access control",
      },
    ]}
  />

  <!-- Features3 Widget: Projects ************** -->

  <Features3
    id="projects"
    title="Selected projects"
    subtitle="A few systems I built end-to-end."
    columns={3}
    defaultIcon="tabler:point-filled"
    items={[
      {
        title: "National Online Passport System",
        description:
          "High-volume public-sector system for Afghanistan, serving 10,000+ daily users. C#, ASP.NET, SQL Server.",
      },
      {
        title: "MIDAS / SHURA",
        description:
          "Biometric identity & registration platforms for the International Organization for Migration (UN), built offline-first. .NET Core, Vue, React, Kafka.",
      },
      {
        title: "ZootZoot",
        description:
          "Cross-platform food/grocery delivery marketplace app. Vue, React Native, Laravel, Firebase.",
      },
    ]}
  />

  <!-- BlogLatestPost Widget **************** -->

  <BlogLatestPosts
    id="blog"
    title="Writing"
    information={`Notes from hands-on engineering work.`}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </BlogLatestPosts>
</Layout>
